#!/bin/sh
# git-wt の wt.deletehook から呼ばれ、削除する worktree を開いている herdr の workspace を閉じる。
# deletehook は削除の前に worktree を cwd として動く。その workspace の中で git wt -d を実行していると、
# すぐに閉じたときに git wt も止まるので、切り離して動かし、ディレクトリが消えてから閉じる。
# 削除が中止されたときは閉じないように、待つのは 60 秒まで。

dir=$(pwd -P)
ids=$(herdr workspace list 2>/dev/null |
    jq -r --arg d "$dir" '.result.workspaces[] | select(.worktree.checkout_path == $d) | .workspace_id')
[ -n "$ids" ] || exit 0

nohup sh -c '
    dir=$1; shift
    for _ in $(seq 60); do [ -d "$dir" ] && sleep 1; done
    [ -d "$dir" ] && exit
    sleep 1
    for id; do herdr workspace close "$id"; done
' sh "$dir" $ids >/dev/null 2>&1 &
