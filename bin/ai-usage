#!/usr/bin/env node
// Claude Code / Codex CLI の残り usage limit (5h window, weekly window) を表示する
//
// claude (cli): `claude -p` に get_usage control request を送って取得する。モデルを呼ばないので usage を消費しない。
//   usage API が 429 などで取れないときは usage-record mod (claude/skills/usage-record) の記録を出す。
// claude (app): Claude.app のログインの値は claude -p で取れないため、usage-record mod の記録を出す。
// codex: 非公式 API を直叩きして取得する。
const { execFile } = require("node:child_process");
const { readFile } = require("node:fs/promises");
const { homedir } = require("node:os");

const HOUR = 3600;
const DAY = 24 * HOUR;
const now = Date.now() / 1000;
const home = homedir();
const [red, yellow, green, dim, reset] = ["\x1b[31m", "\x1b[33m", "\x1b[32m", "\x1b[2m", "\x1b[0m"];

// 各取得元は { heading, rows } か { error } を返す
// row は { label, pct, resetsAt (unix 秒), window (秒) }

async function claudeCli() {
  // skip_behaviors で /usage の使用傾向の集計を飛ばし、rate limits だけを取る
  // 起動を軽くするため、会話ログ・MCP・settings を読まない (--bare はログインできないので使えない)
  const request = { type: "control_request", request_id: "ai-usage", request: { subtype: "get_usage", skip_behaviors: true } };
  const out = await run(
    "claude",
    ["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
      "--no-session-persistence", "--strict-mcp-config", "--setting-sources="],
    `${JSON.stringify(request)}\n`,
  );
  const response = out.split("\n").map(parseJson).find((message) => message?.type === "control_response");
  const kinds = {
    session: () => ["5h", 5 * HOUR],
    weekly_all: () => ["weekly", 7 * DAY],
    weekly_scoped: (limit) => [`weekly/${limit.scope?.model?.display_name ?? "?"}`, 7 * DAY],
  };
  const rows = (response?.response?.response?.rate_limits?.limits ?? []).flatMap((limit) => {
    if (!kinds[limit.kind]) return [];
    const [label, window] = kinds[limit.kind](limit);
    return [{ label, pct: limit.percent, resetsAt: secs(limit.resets_at), window }];
  });

  // usage API が 429 などで取れないときは mod の記録を出す
  if (rows.length === 0) return claudeRecorded("cli", "claude (cli)");
  return { heading: "claude (cli)", rows };
}

// usage-record mod の記録 (session = cli | desktop) を出す
async function claudeRecorded(session, name) {
  const record = await readJson(`${home}/.cache/claude-usage-record/${session}.json`);
  if (record === undefined) return { error: `${name}: usage-record mod の記録がありません` };

  const kinds = { five_hour: ["5h", 5 * HOUR], seven_day: ["weekly", 7 * DAY] };
  const recordedAt = secs(record.recordedAt);
  return {
    heading: `${name} · updated at ${fmtAt(recordedAt)} (${fmtDuration(now - recordedAt)} ago)`,
    rows: record.rateLimits.flatMap((limit) => {
      if (!kinds[limit.kind]) return [];
      const [label, window] = kinds[limit.kind];
      return [{ label, pct: limit.percentUsed, resetsAt: secs(limit.resetsAt), window }];
    }),
  };
}

async function codex() {
  const authFile = `${home}/.codex/auth.json`;
  const auth = await readJson(authFile);
  if (auth === undefined) return { error: `codex: ${authFile} not found` };
  if (!auth.tokens?.access_token) return { error: "codex: token not found" };

  let res;
  try {
    res = await fetch("https://chatgpt.com/backend-api/wham/usage", {
      headers: {
        Authorization: `Bearer ${auth.tokens.access_token}`,
        "ChatGPT-Account-Id": auth.tokens.account_id ?? "",
      },
    });
  } catch (error) {
    return { error: `codex: request failed (${error.cause?.code ?? error.message})` };
  }
  if (res.status === 429) return { error: "codex: rate limited (429), しばらく待って再実行してください" };
  if (!res.ok) return { error: `codex: request failed (HTTP ${res.status})` };

  const { primary_window, secondary_window } = (await res.json()).rate_limit;
  const row = (label, w) => ({ label, pct: w.used_percent, resetsAt: w.reset_at, window: w.limit_window_seconds });
  return { heading: "codex", rows: [row("5h", primary_window), row("weekly", secondary_window)] };
}

function formatRow({ label, pct, resetsAt, window }) {
  let elapsedPct;
  if (resetsAt !== undefined) {
    const remain = Math.min(window, Math.max(0, resetsAt - now));
    elapsedPct = ((window - remain) * 100) / window;
  }

  // 色判定は使用率の絶対値ではなく、このペースを維持した場合の予測着地率で決める
  // 予測着地率 = 使用率 ÷ 経過割合 × 100 (このペースのままリセットまで使い続けたら何%に達するか)
  // <90%: 余裕(緑) / 90〜100%: オンペース(黄) / 100%超: このままだと枯渇する(赤)
  // ウィンドウ開始直後(経過5%未満)は少し使っただけで予測が暴れるため判定を保留する
  let color = green;
  if (elapsedPct >= 5) {
    const projected = (pct * 100) / elapsedPct;
    color = projected > 100 ? red : projected >= 90 ? yellow : green;
  }
  const percent = (p) => `${String(Math.round(p)).padStart(3)}%`;
  const elapsed = elapsedPct === undefined ? "  -" : percent(elapsedPct);

  return `  ${label.padEnd(12)} [${color}${bar(pct, elapsedPct ?? 0)}${reset}] ${dim}used${reset} ` +
    `${color}${percent(pct)}${reset} / ${elapsed} ${dim}elapsed ·${reset} ` +
    `reset at ${fmtAt(resetsAt)} ${dim}in ${fmtRemain(resetsAt)}${reset}`;
}

function bar(pct, elapsedPct) {
  // 実際の使用率(pct)を濃い塗り█、経過時間の割合(elapsedPct)を薄塗り░で表す。
  // 同じマスでは█が░より優先して見える(実使用が経過時間を追い越している=ペースが速い)。
  // █が░の範囲より短ければ、その分░だけが右に残る(=余裕がある)。
  const width = 10;
  const cells = (p) => Math.min(width, Math.max(0, Math.floor((p * width) / 100)));
  const filled = cells(pct);
  const elapsed = cells(elapsedPct);
  return Array.from({ length: width }, (_, i) => (i < filled ? "█" : i < elapsed ? "░" : " ")).join("");
}

function fmtRemain(resetsAt) {
  if (resetsAt === undefined) return "?";
  return resetsAt <= now ? "reset待ち" : fmtDuration(resetsAt - now);
}

function fmtDuration(seconds) {
  seconds = Math.max(0, Math.floor(seconds));
  const d = Math.floor(seconds / DAY);
  const h = Math.floor((seconds % DAY) / HOUR);
  const m = Math.floor((seconds % HOUR) / 60);
  const pad = (n) => String(n).padStart(2, "0");
  // 最大2単位までに絞って簡潔にする: 日以上は d+h、時間未満は h+m、分未満は m のみ
  if (d > 0) return `${d}d${pad(h)}h`;
  if (h > 0) return `${h}h${pad(m)}m`;
  return `${m}m`;
}

function fmtAt(unixSecs) {
  if (unixSecs === undefined) return "?";
  const t = tokyo(unixSecs);
  return `${t.month}/${t.day}(${t.weekday}) ${t.hour}:${t.minute}`;
}

const tokyoFormat = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit", day: "2-digit", weekday: "short",
  hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23",
});

function tokyo(unixSecs) {
  return Object.fromEntries(tokyoFormat.formatToParts(new Date(unixSecs * 1000)).map((p) => [p.type, p.value]));
}

function secs(iso) {
  const ms = Date.parse(iso);
  return Number.isNaN(ms) ? undefined : ms / 1000;
}

function parseJson(text) {
  try {
    return JSON.parse(text);
  } catch {
    return undefined;
  }
}

function readJson(path) {
  return readFile(path, "utf8").then(parseJson, () => undefined);
}

function run(command, args, input) {
  return new Promise((resolve) => {
    const child = execFile(command, args, { maxBuffer: 16 * 1024 * 1024 }, (_error, stdout) => resolve(stdout ?? ""));
    child.stdin.on("error", () => {});
    child.stdin.end(input);
  });
}

async function main() {
  // claude (cli) の取得は数秒かかるため、すべて並列に取得してから順に表示する
  const results = await Promise.all([claudeCli(), claudeRecorded("desktop", "claude (app)"), codex()]);

  const t = tokyo(now);
  console.log(`${dim}${t.year}-${t.month}-${t.day}(${t.weekday}) ${t.hour}:${t.minute}:${t.second}${reset}`);
  for (const result of results) {
    console.log();
    if (result.error) {
      console.error(result.error);
      continue;
    }
    console.log(`${dim}${result.heading}${reset}`);
    for (const row of result.rows) console.log(formatRow(row));
  }
}

main();
